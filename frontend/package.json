{
  "name": "node-tree-app",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run start:python\" \"npm run start:react\" \"npm run start:electron\"",
    "start:python": "cd .. && python -m core.server",
    "start:react": "npx vite",
    "start:electron": "wait-on http://localhost:5173 && electron electron/main.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
