{
	"name": "node-tree-app",
	"version": "1.0.0",
	"main": "electron/main.js",
	"scripts": {
		"dev": "concurrently -k \"npm run start:python\" \"npm run start:react\" \"npm run start:electron\"",
		"start:python": "cd .. && ./.venv/bin/python -m uvicorn core.server:app --reload --port 8000",
		"start:react": "vite",
		"start:electron": "wait-on http://localhost:5173 http://localhost:8000/api/health && electron electron/main.js"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^8.2.2",
		"electron": "44.4.3",
		"vite": "8.3.0",
		"wait-on": "^7.2.0"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}

